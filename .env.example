MONGODB_URI=mongodb+srv://...
PORT=3000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Generate a unique random value (at least 32 characters) for production.
JWT_SECRET=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
# Optional: enables the real AI chat assistant. Keep this value server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# One-time local admin setup (never commit real values to .env).
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_USERNAME=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
# Required only when intentionally promoting/resetting an already-existing account.
ADMIN_RESET_EXISTING=false
