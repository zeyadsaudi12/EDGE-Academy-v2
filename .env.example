MONGODB_URI=mongodb+srv://...
PORT=3000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Generate a unique random value (at least 32 characters) for production.
JWT_SECRET=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# RAG System — Google Gemini (مجاني: 1500 req/يوم)
# احصل على API Key من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# RAG System (ChromaDB Vector Database)
CHROMA_URL=http://localhost:8000
# مسار تخزين ملفات PDF المؤقتة قبل المعالجة
UPLOAD_DIR=./uploads/pdfs

# One-time local admin setup (never commit real values to .env).
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_USERNAME=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
# Required only when intentionally promoting/resetting an already-existing account.
ADMIN_RESET_EXISTING=false
