<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /masar/

    # 1. منع استعراض محتويات المجلدات لحماية الملفات
    Options -Indexes

    # 2. تحويل أي طلب لـ index.php إلى الرابط النظيف /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/(?:masar/)?index\.php[?\s] [NC]
    RewriteRule ^index\.php$ /masar/ [R=301,L]

    # 3. إخفاء امتداد .php وتحويل الروابط المباشرة مثل /admin.php إلى /admin
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/(?:masar/)?([^.?\s]+)\.php[?\s] [NC]
    RewriteCond %{REQUEST_URI} !^/masar/backend/ [NC]
    RewriteCond %{REQUEST_URI} !^/masar/api/ [NC]
    RewriteRule ^([^.?\s]+)\.php$ /masar/$1 [R=301,L,QSA]

    # 4. توجيه جميع طلبات API إلى الراوتر الخلفي
    RewriteRule ^api(/.*)?$ backend/public/index.php [L,QSA]

    # 5. استثناء الملفات والمجلدات الموجودة فعلياً (الصور، css، js، الخطوط)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 6. التوجيه الداخلي: فتح ملف الـ .php تلقائياً عند طلب رابط نظيف (مثل /admin أو /exams)
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^.?\s]+)/?$ $1.php [L,QSA]
</IfModule>

# منع الوصول المباشر للملفات الحساسة (مثل السكريبتات وملفات التكوين والنسخ الاحتياطية)
<FilesMatch "\.(env|sql|log|ps1|sh|bak|config|git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# تفعيل ضغط الملفات GZIP لتحسين سرعة تحميل الموقع
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# تفعيل التخزين المؤقت للمتصفح (Caching) للملفات الثابتة
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# رؤوس الأمان (Security Headers)
<IfModule mod_headers.c>
    # منع تضمين الموقع داخل iframes خارجية (حماية من Clickjacking)
    Header always set X-Frame-Options "SAMEORIGIN"
    # منع المتصفح من تخمين نوع الملفات (MIME Sniffing)
    Header always set X-Content-Type-Options "nosniff"
    # تفعيل حماية المتصفح من XSS
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>
